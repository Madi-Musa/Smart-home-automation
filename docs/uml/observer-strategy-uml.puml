@startuml

title Observer and Strategy - UML Class Diagram

left to right direction
scale 2

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

package "Core System" {

    interface SmartDevice {
        +getId(): String
        +getName(): String
        +turnOn(): void
        +turnOff(): void
        +isOn(): boolean
    }

    class SmartHome {
        -name: String
        -devices: List<SmartDevice>
        +getName(): String
        +getDevices(): List<SmartDevice>
        +getDeviceById(id): SmartDevice
    }

    interface SmartHomeController {
        +turnOn(deviceId): void
        +turnOff(deviceId): void
        +getDevices(): List<SmartDevice>
    }
}

package "Observer Pattern" {

    interface DeviceObserver {
        +onDeviceChanged(device): void
    }

    interface DeviceEventPublisher {
        +notifyDeviceChanged(device): void
    }

    class DeviceEventManager {
        -observers: Set<DeviceObserver>
        +subscribe(observer): void
        +unsubscribe(observer): void
        +notifyDeviceChanged(device): void
    }

    class ConsoleDeviceObserver {
        +onDeviceChanged(device): void
    }
}

package "Shared Controller" {

    class DefaultSmartHomeController {
        -home: SmartHome
        -publisher: DeviceEventPublisher
        +turnOn(deviceId): void
        +turnOff(deviceId): void
        -setPower(deviceId, on): void
        +getDevices(): List<SmartDevice>
    }
}

package "Strategy Pattern" {

    interface AutomationStrategy {
        +apply(controller): void
    }

    class HomeModeStrategy {
        +apply(controller): void
    }

    class AwayModeStrategy {
        +apply(controller): void
    }

    class AutomationContext {
        -controller: SmartHomeController
        -strategy: AutomationStrategy
        +setStrategy(strategy): void
        +execute(): void
    }
}

SmartHome "1" o-- "0..*" SmartDevice : contains

DeviceEventManager ..|> DeviceEventPublisher
ConsoleDeviceObserver ..|> DeviceObserver

DeviceEventManager "1" o-- "0..*" DeviceObserver : subscribers

DefaultSmartHomeController ..|> SmartHomeController

DefaultSmartHomeController --> SmartHome : manages
DefaultSmartHomeController --> DeviceEventPublisher : publishes events

DeviceEventPublisher ..> SmartDevice : reports changes

HomeModeStrategy ..|> AutomationStrategy
AwayModeStrategy ..|> AutomationStrategy

AutomationContext --> AutomationStrategy : selected strategy
AutomationContext --> SmartHomeController : controls

AutomationStrategy ..> SmartHomeController : applies actions

@enduml
