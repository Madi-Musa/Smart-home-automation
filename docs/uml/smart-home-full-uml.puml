@startuml
scale 2

title Smart Home Automation System - Full UML Class Diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

package "Core" {
    interface SmartDevice {
        + getId(): String
        + getName(): String
        + turnOn(): void
        + turnOff(): void
        + isOn(): boolean
    }

    class SmartHome {
        - name: String
        - devices: List<SmartDevice>
        + getName(): String
        + getDevices(): List<SmartDevice>
        + getDeviceById(id): SmartDevice
    }

    class SmartLight {
        - id: String
        - name: String
        - on: boolean
    }

    class Thermostat {
        - id: String
        - name: String
        - on: boolean
        - temperature: double
        + getTemperature(): double
        + setTemperature(value): void
    }

    interface SmartHomeController {
        + turnOn(deviceId): void
        + turnOff(deviceId): void
        + getDevices(): List<SmartDevice>
    }
}

package "Factory Method" {
    abstract class DeviceFactory {
        + {abstract} createDevice(id, name): SmartDevice
        + createAndTurnOn(id, name): SmartDevice
    }

    class SmartLightFactory
    class ThermostatFactory
}

package "Builder" {
    class SmartHomeBuilder {
        - name: String
        - devices: List<SmartDevice>
        + withName(name): SmartHomeBuilder
        + addDevice(device): SmartHomeBuilder
        + build(): SmartHome
    }
}

package "Adapter" {
    class LegacyLamp {
        - powered: boolean
        + switchOn(): void
        + switchOff(): void
        + hasPower(): boolean
    }

    class LampAdapter {
        - id: String
        - name: String
        - lamp: LegacyLamp
    }
}

package "Facade" {
    class SmartHomeFacade {
        - home: SmartHome
        - controller: SmartHomeController
        - NIGHT_TEMPERATURE: double
        + turnOn(deviceId): void
        + turnOff(deviceId): void
        + getDevices(): List<SmartDevice>
        + activateNightMode(deviceId, thermostatId): void
    }
}

package "Observer" {
    interface DeviceObserver {
        + onDeviceChanged(device): void
    }

    interface DeviceEventPublisher {
        + notifyDeviceChanged(device): void
    }

    class DeviceEventManager {
        - observers: Set<DeviceObserver>
        + subscribe(observer): void
        + unsubscribe(observer): void
        + notifyDeviceChanged(device): void
    }

    class ConsoleDeviceObserver {
        + onDeviceChanged(device): void
    }
}

package "Controller" {
    class DefaultSmartHomeController {
        - home: SmartHome
        - publisher: DeviceEventPublisher
        + turnOn(deviceId): void
        + turnOff(deviceId): void
        - setPower(deviceId, on): void
        + getDevices(): List<SmartDevice>
    }
}

package "Strategy" {
    interface AutomationStrategy {
        + apply(controller): void
    }

    class HomeModeStrategy {
        + apply(controller): void
    }

    class AwayModeStrategy {
        + apply(controller): void
    }

    class AutomationContext {
        - controller: SmartHomeController
        - strategy: AutomationStrategy
        + setStrategy(strategy): void
        + execute(): void
    }
}

class Main {
    + {static} main(args): void
}

SmartLight ..|> SmartDevice
Thermostat ..|> SmartDevice
LampAdapter ..|> SmartDevice

SmartHome "1" o-- "0..*" SmartDevice : devices

SmartLightFactory --|> DeviceFactory
ThermostatFactory --|> DeviceFactory
DeviceFactory ..> SmartDevice : creates

SmartHomeBuilder o-- SmartDevice : adds
SmartHomeBuilder ..> SmartHome : builds

LampAdapter *-- LegacyLamp : wraps

SmartHomeFacade ..|> SmartHomeController
SmartHomeFacade --> SmartHome : manages
SmartHomeFacade --> SmartHomeController : delegates
SmartHomeFacade ..> Thermostat : night mode

DefaultSmartHomeController ..|> SmartHomeController
DefaultSmartHomeController --> SmartHome
DefaultSmartHomeController --> DeviceEventPublisher

DeviceEventManager ..|> DeviceEventPublisher
DeviceEventManager "1" o-- "0..*" DeviceObserver
ConsoleDeviceObserver ..|> DeviceObserver
DeviceEventPublisher ..> SmartDevice : notifies

HomeModeStrategy ..|> AutomationStrategy
AwayModeStrategy ..|> AutomationStrategy

AutomationContext --> AutomationStrategy : selected strategy
AutomationContext --> SmartHomeController : controls

Main ..> DeviceFactory
Main ..> SmartHomeBuilder
Main ..> SmartHomeFacade
Main ..> DeviceEventManager
Main ..> AutomationContext

@enduml
